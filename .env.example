# ═══════════════════════════════════════════════════════════
# Skyra Sync Worker — Environment Variables Template
# Copy ke .env (gitignored) di VPS
# ═══════════════════════════════════════════════════════════

# --- UniPlay API ---
UNIPLAY_API_KEY=paste-api-key-dari-uniplay-dashboard
UNIPLAY_PINCODE=paste-pincode-untuk-confirm-payment

# --- Supabase ---
SUPABASE_URL=https://xyqgopojgnimiisitfvw.supabase.co
SUPABASE_SERVICE_KEY=paste-service-role-key-dari-supabase-settings-api

# --- Sync Config ---
MARKUP_PCT=2.5
CRON_SCHEDULE=*/15 * * * *

# --- Order Poller ---
# Interval cek Supabase buat paid orders (ms)
POLL_INTERVAL_MS=5000

# --- Telegram Bot (notifications + manual confirm) ---
# Dari @BotFather: /newbot
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:AAxxxxxxxxxxxxxxxxxxxxxxx
# Dari @userinfobot (personal chat) atau group ID (diawali -)
TELEGRAM_CHAT_ID=123456789

# --- Site URL (buat link di telegram) ---
PUBLIC_SITE_URL=https://skyra.id
